---
import EducationItem from "./EducationItem.astro";

import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const EDUCATION = [
  {
    title: t('educationTitle1'),
    place: "Universidad Tecnológica Nacional - Facultad Regional Mendoza",
    date: t('date1'),
    description: t('educationDescription1'),
  },
  {
    title: t('educationTitle2'),
    place: "Globant, Mercado Libre, Digital House",
    date: t('date2'),
    description: t('educationDescription2'),
  },
  {
    title: t('educationTitle3'),
    place: "Globant, Mercado Libre, Digital House",
    date: t('date3'),
    description: t('educationDescription3'),
  },
  
];
---

<ol class="relative mt-16">
  {EDUCATION.map((education) => 
    <li class="">
        <EducationItem {...education}/>
    </li>
  )}
</ol>
