---
import Badge from "../components/Badge.astro";
import SocialPill from "../components/SocialPill.astro";

import LinkedInIcon from "../icons/LinkedIn.astro";
import DownloadIcon from "../icons/Download.astro";
import MailIcon from "../icons/Mail.astro";
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-20"
      src="/profile.webp"
      alt="profile"
    />
    <div class="flex items-center transition md:justify-center">
      <Badge>Available for hiring</Badge>
    </div>
  </div>
</div>

<h1
  class="text-4xl font-bold tracking-tight sm:text-5xl text-gray-800 dark:text-white"
>
  Hello there, I'm Majo
</h1>

<p
  class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-green-500 [&>strong]:text-blue-800 [&>strong]:font-semibold dark:text-gray-300"
>
  <strong>Frontend developer</strong> from Mendoza, Argentina. I specialize in building
  responsive web solutions that combine sleek design with intuitive navigation.
</p>

<nav class="flex flex-wrap gap-4 mt-8">
  <SocialPill href="/Resume-VillarrealMariaJose.pdf">
    <DownloadIcon class="size-4 md:size-6" /> Download Resume
  </SocialPill>
  <SocialPill href="https://www.linkedin.com/in/mariajose-villarreal">
    <LinkedInIcon class="size-4 md:size-6" /> LinkedIn
  </SocialPill>
  <SocialPill copy>
    <MailIcon class="size-4 md:size-6" /> villarrealmariaj@gmail.com
  </SocialPill>
</nav>

<script>
   function handleCopy() {
  const text = "villarrealmariaj@gmail.com";
  const textArea = document.createElement("textarea");
  textArea.value = text;
  document.body.appendChild(textArea);
  textArea.select();
  document.execCommand("copy");
  document.body.removeChild(textArea);
  alert("Email address copied to clipboard!");
}


  document.addEventListener('DOMContentLoaded', () => {
  const mailButton = document.getElementById('mail-button');
  mailButton?.addEventListener('click', handleCopy);
});
</script>
