---
import Globe from "./Globe.astro";
import CopyEmail from "./CopyEmail.astro";

import LinkedInIcon from "../icons/HeroIcons/LinkedIn.astro";
import DownloadIcon from "../icons/HeroIcons/Download.astro";

import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="top"
  class="mx-auto grid max-w-5xl items-center gap-14 px-5 pb-16 pt-28 md:grid-cols-[1.1fr_1fr] md:gap-8 md:pb-24 md:pt-40"
>
  <div>
    {/*
      Etiqueta para cuando esté buscando trabajo: reemplazar el <a> de abajo por esto.

      <p
        class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1 text-xs font-medium text-muted backdrop-blur"
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
        </span>
        {t("badgeAvailable")}
      </p>
    */}
    <a
      href="#experience"
      class="group inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1 text-xs font-medium text-muted backdrop-blur transition hover:border-accent/40 hover:text-ink"
    >
      <span class="size-2 rounded-full bg-accent"></span>
      {t("badgeCurrent")}
      <span class="font-semibold text-ink">Grupo Broda</span>
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
    </a>

    <p class="eyebrow mt-8">{t("role")}</p>
    <h1 class="mt-3 font-display text-6xl leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl">
      {t("greeting")}
      <em class="relative whitespace-nowrap text-accent">
        Majo
        <svg
          aria-hidden="true"
          viewBox="0 0 200 20"
          preserveAspectRatio="none"
          class="absolute -bottom-2 left-0 h-3 w-full text-pop"
        >
          <path d="M3 14 C 50 4, 120 4, 197 10" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"></path>
        </svg>
      </em>
    </h1>

    <p class="mt-8 max-w-md text-pretty text-lg leading-relaxed text-muted">
      {t("heroLead")}
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href={t("resumeURL")} download class="btn-primary">
        <DownloadIcon class="size-4" />
        {t("resume")}
      </a>
      <a
        href="https://www.linkedin.com/in/mariajose-villarreal"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost"
      >
        <LinkedInIcon class="size-4" />
        LinkedIn
      </a>
      <CopyEmail email="villarrealmariaj@gmail.com" />
    </div>
  </div>

  <Globe />
</section>
