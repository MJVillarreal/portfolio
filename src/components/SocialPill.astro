{
  Astro.props.copy ? (
   <button
   id="mail-button"
      class="inline-flex items-center justify-center gap-2 px-4 py-1 text-gray-800 transition border border-gray-800 rounded-full dark:border-gray-300 dark:text-gray-300 text-md md:py-2 md:px-4 text-xs lg:text-base hover:bg-black/15 hover:scale-110 dark:hover:bg-white/5 group max-w-fit focus:outline-none focus-visible:outline-none"
    >
      <slot />
    </button>
  ) : (
    <a
      {...Astro.props}
      class="inline-flex items-center justify-center gap-2 px-4 py-1 text-gray-800 transition border border-gray-800 rounded-full dark:border-gray-300 dark:text-gray-300 text-md md:py-2 md:px-4 text-xs lg:text-base hover:bg-black/15 hover:scale-110 dark:hover:bg-white/5 group max-w-fit focus:outline-none focus-visible:outline-none"
      target="_blank"
      rel="noopener noreferrer"
    >
      <slot />
    </a>
  )
}