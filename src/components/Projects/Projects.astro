---
import LinksPill from "./LinksPill.astro";
import DemoIcon from "../../icons/ProjectIcons/Demo.astro";
import GitHubIcon from "../../icons/ProjectIcons/GitHub.astro";

import CSS from "../../icons/ProjectIcons/CSS.astro";
import HTML from "../../icons/ProjectIcons/HTML.astro";
import Javascript from "../../icons/ProjectIcons/Javascript.astro";
import Material from "../../icons/ProjectIcons/MaterialUI.astro";
import Mongo from "../../icons/ProjectIcons/Mongo.astro";
import MySQL from "../../icons/ProjectIcons/MySQL.astro";
import Next from "../../icons/ProjectIcons/Nextjs.astro";
import Node from "../../icons/ProjectIcons/Node.astro";
import React from "../../icons/ProjectIcons/React.astro";
import Tailwind from "../../icons/ProjectIcons/Tailwind.astro";
import Typescript from "../../icons/ProjectIcons/Typescript.astro";

const TAGS = {
  CSS: {
    name: "CSS",
    class:
      "border border-[#0C73B8] text-black dark:bg-[#23272F] dark:text-white",
    icon: CSS,
  },
  HTML: {
    name: "HTML",
    class:
      "border border-[#E34F26] text-black dark:bg-[#23272F] dark:text-white",
    icon: HTML,
  },
  JAVASCRIPT: {
    name: "Javascript",
    class:
      "border border-[#F0DB4F] text-black dark:bg-[#23272F] dark:text-white",
    icon: Javascript,
  },
  MATERIAL: {
    name: "Material UI",
    class:
      "border border-[#0073E6] text-black dark:bg-[#0F1214] dark:text-white",
    icon: Material,
  },
  MONGO: {
    name: "Mongo DB",
    class:
      "border border-[#01EC64] text-black dark:bg-[#001E2B] dark:text-white",
    icon: Mongo,
  },
  MYSQL: {
    name: "MySQL",
    class:
      "border border-[#00618A] text-black dark:bg-[#001524] dark:text-white",
    icon: MySQL,
  },
  NEXT: {
    name: "Next.js",
    class:
      "border border-[#000000] dark:border-[#FFFFFF] text-black dark:bg-[#000000] dark:text-white",
    icon: Next,
  },
  NODE: {
    name: "Node.js",
    class:
      "border border-[#5DAC46] text-black dark:bg-[#0D121C] dark:text-white",
    icon: Node,
  },
  REACT: {
    name: "React",
    class:
      "border border-[#58C4DC] text-black dark:bg-[#23272F] dark:text-white",
    icon: React,
  },
  TAILWIND: {
    name: "Tailwind",
    class:
      "border border-[#18B9B9] text-black dark:bg-[#23272F] dark:text-white",
    icon: Tailwind,
  },
  TYPESCRIPT: {
    name: "Typescript",
    class:
      "border border-[#3178C6] text-black dark:bg-[#23272F] dark:text-white",
    icon: Typescript,
  },
};

import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const PROJECTS = [
  {
    title: t("projectTitle1"),
    description: t("projectDescription1"),
    image: "/projects/Marvel-Wiki.webp",
    link: "https://marvel-wiki-tau.vercel.app",
    github: "https://github.com/MJVillarreal/Marvel-Wiki",
    tags: [TAGS.CSS, TAGS.HTML, TAGS.JAVASCRIPT, TAGS.REACT, TAGS.MATERIAL],
  },
  {
    title: t("projectTitle2"),
    description: t("projectDescription2"),
    image: "/projects/DHOdonto.webp",
    link: "https://ctd-esp-fe3-final-one-brown.vercel.app/home",
    github: "https://github.com/MJVillarreal/ctd-esp-fe3-final",
    tags: [TAGS.CSS, TAGS.HTML, TAGS.JAVASCRIPT, TAGS.REACT],
  },
];
---

<div class="flex flex-col p-4 gap-y-16 lg:flex-row gap-4">
  {
    PROJECTS.map(({ title, description, image, link, github, tags }) => (
      <article class="flex flex-col items-center gap-5 px-8 py-5 rounded-lg border border-gray-400 hover:bg-blue-800/10 dark:border-white/10 transition dark:hover:bg-neutral-600/5 w- md:w-2/2 lg:w-1/2">
        <div class="flex items-start w-full">
          <h2 class="text-2xl font-semibold text-blue-800 dark:text-green-500 mb-2">
            {title}
          </h2>
        </div>

        <img
          class="rounded shadow-2xl shadow-white/10 w-full h-auto"
          src={image}
          alt={title}
        />
        <p class="text-lg text-pretty">{description}</p>
        <nav class="w-full flex flex-col gap-4 lg:flex-row justify-between ">
          <LinksPill href={github}>
            <GitHubIcon class="size-4 md:size-5" /> {t("projectCode")}
          </LinksPill>
          <LinksPill href={link}>
            <DemoIcon class="size-4 md:size-5" /> {t("projectDemo")}
          </LinksPill>
        </nav>
        <ul class="flex flex-wrap gap-x-2 mb-2">
          {tags.map((tag) => (
            <li class="pb-3">
              <span
                class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
              >
                <tag.icon class="size-4" /> {tag.name}
              </span>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
