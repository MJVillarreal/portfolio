---
import type { Tech } from "../data/tech";

interface Props {
  tech: Tech;
  class?: string;
}

const { tech, class: className } = Astro.props;

// Los logos casi negros usan el color del texto para verse en modo oscuro
const isDark = (hex: string) => {
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b < 70;
};
---

{
  tech.brand ? (
    <svg viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <path
        d={tech.brand.path}
        fill={tech.mono || isDark(tech.brand.hex) ? "currentColor" : `#${tech.brand.hex}`}
      />
    </svg>
  ) : (
    tech.icon && <tech.icon class={className} aria-hidden="true" />
  )
}
