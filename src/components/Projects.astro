---
import SectionHeading from "./SectionHeading.astro";
import TechChip from "./TechChip.astro";
import ProjectGallery from "./ProjectGallery.astro";
import WorkProjectCard from "./WorkProjectCard.astro";
import GitHubIcon from "../icons/ProjectIcons/GitHub.astro";
import { TECH } from "../data/tech";
import { FEATURED_PROJECT, OTHER_WORK_PROJECTS } from "../data/content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featured = FEATURED_PROJECT[lang];

const SIDE_PROJECTS = [
  {
    title: t("projectTitle1"),
    description: t("projectDescription1"),
    image: "/projects/Notflix.webp",
    link: "https://notflix-azure.vercel.app/",
    github: "https://github.com/MJVillarreal/NOTFLIX",
    tech: [TECH.REACT, TECH.VITE, TECH.FIREBASE, TECH.JAVASCRIPT],
  },
  {
    title: t("projectTitle2"),
    description: t("projectDescription2"),
    image: "/projects/Billwise.webp",
    link: "https://billwise-mjv.vercel.app",
    github: "https://github.com/MJVillarreal/billwise",
    tech: [TECH.NEXT, TECH.TYPESCRIPT, TECH.TAILWIND, TECH.GEMINI, TECH.VITEST, TECH.VERCEL],
  },
];
---

<section id="projects" class="mx-auto max-w-5xl px-5 py-16 md:py-20">
  <SectionHeading index="02" title={t("projects")} />

  <article class="card p-5 md:p-8">
    <p class="eyebrow">{featured.label}</p>
    <div class="mt-3 grid gap-4 md:grid-cols-[1fr_1.2fr] md:items-end md:gap-10">
      <h3 class="font-display text-4xl leading-tight md:text-5xl">{featured.title}</h3>
      <p class="text-pretty leading-relaxed text-muted">{featured.description}</p>
    </div>

    <div class="mt-8">
      <ProjectGallery slides={featured.gallery} />
    </div>

    <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-4">
      {
        featured.highlights.map((item) => (
          <div class="flex flex-col-reverse bg-surface p-4">
            <dt class="mt-1 text-xs leading-snug text-muted">{item.label}</dt>
            <dd class="font-semibold tracking-tight">{item.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        featured.modules.map((module) => (
          <div class="rounded-2xl border border-line bg-bg/60 p-5">
            <h4 class="flex items-center gap-2 font-semibold">
              <span aria-hidden="true" class="size-2 rounded-full bg-accent" />
              {module.name}
            </h4>
            <p class="mt-2 text-pretty text-sm leading-relaxed text-muted">{module.description}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-muted">{featured.shared}</p>

    <ul class="mt-6 flex flex-wrap gap-2 border-t border-line pt-6">
      {featured.tech.map((tech) => <TechChip tech={tech} />)}
    </ul>
  </article>

  <h3 class="eyebrow mb-6 mt-16 text-muted">{t("moreAtBroda")}</h3>
  <div class="grid gap-5 md:grid-cols-2">
    {OTHER_WORK_PROJECTS[lang].map((project) => <WorkProjectCard project={project} />)}
  </div>

  <h3 class="eyebrow mb-6 mt-16 text-muted">{t("sideProjects")}</h3>
  <div class="grid gap-5 md:grid-cols-2">
    {
      SIDE_PROJECTS.map((project) => (
        <article class="card group flex flex-col overflow-hidden p-3 transition hover:-translate-y-1 hover:border-accent/40 hover:shadow-xl hover:shadow-ink/5">
          <div class="overflow-hidden rounded-2xl border border-line">
            <img
              src={project.image}
              alt={`${t("projectScreenshot")} ${project.title}`}
              loading="lazy"
              decoding="async"
              class="aspect-[16/10] w-full object-cover object-top transition duration-500 group-hover:scale-[1.04]"
            />
          </div>
          <div class="flex flex-1 flex-col p-4">
            <h4 class="text-xl font-semibold tracking-tight">{project.title}</h4>
            <p class="mt-2 flex-1 text-pretty text-sm leading-relaxed text-muted">{project.description}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {project.tech.map((tech) => <TechChip tech={tech} />)}
            </ul>
            <div class="mt-5 flex gap-2">
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="btn-primary !px-4 !py-2 text-xs">
                {t("projectDemo")} <span aria-hidden="true">↗</span>
              </a>
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn-ghost !px-4 !py-2 text-xs">
                <GitHubIcon class="size-3.5" /> {t("projectCode")}
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
