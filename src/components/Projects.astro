---
import LinksPill from "../components/LinksPill.astro";
import DemoIcon from "../icons/Demo.astro";
import GitHubIcon from "../icons/GitHub.astro";

import CSS from "../icons/CSS.astro";
import HTML from "../icons/HTML.astro";
import Javascript from "../icons/Javascript.astro";
import Material from "../icons/MaterialUI.astro";
import Mongo from "../icons/Mongo.astro";
import MySQL from "../icons/MySQL.astro";
import Next from "../icons/Nextjs.astro";
import Node from "../icons/Node.astro";
import React from "../icons/React.astro";
import Tailwind from "../icons/Tailwind.astro";
import Typescript from "../icons/Typescript.astro";

const TAGS = {
  CSS: {
    name: "CSS",
    class: "border border-[#0C73B8] bg-[#23272F] text-white",
    icon: CSS,
  },
  HTML: {
    name: "HTML",
    class: "border border-[#E34F26] bg-[#23272F] text-white",
    icon: HTML,
  },
  JAVASCRIPT: {
    name: "Javascript",
    class: "border border-[#F0DB4F] bg-[#23272F] text-white",
    icon: Javascript,
  },
  MATERIAL: {
    name: "Material UI",
    class: "border border-[#0073E6] bg-[#0F1214] text-white",
    icon: Material,
  },
  MONGO: {
    name: "Mongo DB",
    class: "border border-[#01EC64] bg-[#001E2B] text-white",
    icon: Mongo,
  },
  MYSQL: {
    name: "MySQL",
    class: "border border-[#0073E6] bg-[#0F1214] text-white",
    icon: MySQL,
  },
  NEXT: {
    name: "Next.js",
    class: "border border-[#FFFFFF] bg-[#000000] text-white",
    icon: Next,
  },
  NODE: {
    name: "Node.js",
    class: "border border-[#5DAC46] bg-[#0D121C] text-white",
    icon: Node,
  },
  REACT: {
    name: "React",
    class: "border border-[#58C4DC] bg-[#23272F] text-white",
    icon: React,
  },
  TAILWIND: {
    name: "Tailwind",
    class: "border border-[#18B9B9] bg-[#23272F] text-white",
    icon: Tailwind,
  },
  TYPESCRIPT: {
    name: "Typescript",
    class: "border border-[#3178C6] bg-[#23272F] text-white",
    icon: Typescript,
  },
};

const PROJECTS = [
  {
    title: "Project 1",
    description:
      "This is a description of project 1.This is a description of project 1.This is a description of project 1.This is a description of project 1.This is a description of project 1.",
    image: "/projects/Project-1.webp",
    link: "https://example.com/project1",
    github: "https://github.com/MJVillarreal/portfolio-v2",
    tags: [
      TAGS.CSS,
      TAGS.HTML,
      TAGS.JAVASCRIPT,
      TAGS.MATERIAL,
      TAGS.MONGO,
      TAGS.MYSQL,
    ],
  },
  {
    title: "Project 2",
    description:
      "This is a description of project 222222222222222. This is a description of project 222222222222222222222.This is a description of project 1.SecondSecondSe condSecondSecondS econdS econdSe condSeco ndSecondSecond SecondSe condSecond SecondSecond",
    image: "/projects/Project-1.webp",
    link: "https://example.com/project2",
    github: "https://github.com/MJVillarreal/portfolio",
    tags: [TAGS.NEXT, TAGS.NODE, TAGS.REACT, TAGS.TAILWIND, TAGS.TYPESCRIPT],
  },
];
---

<div class="flex flex-wrap gap-10">
  {
    PROJECTS.map(({ title, description, image, link, github, tags }) => (
      <article class="flex flex-col items-center gap-5 px-8 py-5 rounded-lg border border-gray-400 hover:bg-blue-800/10 dark:border-white/10 transition dark:hover:bg-neutral-600/5"> 
        <div class="flex items-start w-full">
          <h2 class="text-2xl font-semibold text-blue-800 dark:text-green-500 mb-2">
            {title}
          </h2>
        </div>

        <img
          class="rounded shadow-2xl shadow-white/10"
          src={image}
          alt={title}
        />
        <p class="text-lg text-pretty">{description}</p>
        <nav class="w-full flex flex-col gap-4 sm:flex-row justify-between ">
          <LinksPill href={github}>
            <GitHubIcon class="size-4 md:size-5" /> CODE
          </LinksPill>
          <LinksPill href={link}>
            <DemoIcon class="size-4 md:size-5" /> DEMO
          </LinksPill>
        </nav>
        <ul class="flex gap-x-2 flex-row mb-2">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
              >
                <tag.icon class="size-4" /> {tag.name}
              </span>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
