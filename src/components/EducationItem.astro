---
interface Props {
  title: string;
  place: string;
  date: string;
  description: string;
}

const { title, place, date, description } = Astro.props;
---

<div
  class="absolute w-3 h-3 bg-gray-200 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900 dark:bg-gray-700"
>
</div>
<h3 class="text-lg font-semibold text-yellow-300 mt-2">{title}</h3>
<h3 class="text-lg font-semibold text-gray-200">{place}</h3>
<time class="mb-1 text-sm font-normal leading-none text-sky-200/80">{date}</time
>
<p class="mb-4 text-base font-normal text-gray-200 text-pretty">
  {description}
</p>
