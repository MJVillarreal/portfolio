---
import ThemeToggle from "./ThemeToggle.astro";

import { getRelativeLocaleUrl } from "astro:i18n";
import { languages } from "../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeUrl = getRelativeLocaleUrl(lang, "");
const otherLang = Object.keys(languages).find((l) => l !== lang)!;

const navItems = [
  { title: t("experience"), section: "experience" },
  { title: t("projects"), section: "projects" },
  { title: t("education"), section: "education", hideOnMobile: true },
  { title: t("about"), section: "about" },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-4">
  <div
    id="header-bar"
    class="mx-auto flex max-w-5xl items-center justify-between gap-2 rounded-full border border-transparent px-2 py-1.5 transition-all duration-300 sm:px-3"
  >
    <a
      href={`${homeUrl}#top`}
      class="hidden whitespace-nowrap px-2 text-sm font-semibold tracking-tight transition-colors hover:text-accent md:block"
      title={t("home")}
    >
      María José Villarreal
    </a>

    <nav
      aria-label={t("mainNav")}
      class="no-scrollbar relative flex min-w-0 items-center overflow-x-auto text-xs sm:text-sm"
    >
      <span
        id="nav-indicator"
        aria-hidden="true"
        class="absolute left-0 top-1/2 h-8 -translate-y-1/2 rounded-full bg-ink opacity-0 transition-all duration-300 ease-out"
      ></span>
      {
        navItems.map((link) => (
          <a
            class:list={["relative z-10 whitespace-nowrap rounded-full px-2.5 py-1.5 font-medium text-muted transition-colors duration-300 hover:text-ink aria-[current=true]:text-bg sm:px-3.5", link.hideOnMobile && "hidden sm:block"]}
            data-nav-link
            data-section={link.section}
            href={`${homeUrl}#${link.section}`}
          >
            {link.title}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center">
      <a
        href={getRelativeLocaleUrl(otherLang, "")}
        hreflang={otherLang}
        lang={otherLang}
        title={t("switchLanguage")}
        aria-label={t("switchLanguage")}
        class="grid size-9 place-items-center rounded-full font-mono text-xs font-semibold uppercase text-muted transition hover:bg-ink/5 hover:text-ink"
      >
        {otherLang}
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  #header-bar.is-scrolled {
    @apply border-line bg-surface/75 shadow-lg shadow-ink/5 backdrop-blur-xl;
  }

  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initNav() {
    const bar = document.getElementById("header-bar");
    const indicator = document.getElementById("nav-indicator");
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
    ];
    const sections = links
      .map((link) => document.getElementById(link.dataset.section!))
      .filter((s): s is HTMLElement => s !== null);

    const update = () => {
      bar?.classList.toggle("is-scrolled", window.scrollY > 16);

      // La sección activa es la última cuyo borde superior pasó el 35% de la pantalla
      const line = window.innerHeight * 0.35;
      let active: string | null = null;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= line) active = section.id;
      }

      const activeLink = links.find((l) => l.dataset.section === active);
      links.forEach((link) => {
        if (link === activeLink) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });

      if (!indicator) return;
      if (activeLink && activeLink.offsetWidth > 0) {
        indicator.style.opacity = "1";
        indicator.style.width = `${activeLink.offsetWidth}px`;
        indicator.style.transform = `translate(${activeLink.offsetLeft}px, -50%)`;
      } else {
        indicator.style.opacity = "0";
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };

    const controller = new AbortController();
    window.addEventListener("scroll", onScroll, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("resize", onScroll, { signal: controller.signal });
    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
    });

    update();
  }

  document.addEventListener("astro:page-load", initNav);
</script>
