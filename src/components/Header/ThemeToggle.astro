---
import SunIcon from "../../icons/HeaderIcons/Sun.astro";
import MoonIcon from "../../icons/HeaderIcons/Moon.astro";
import SystemIcon from "../../icons/HeaderIcons/System.astro";

import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const THEMES = [
  { value: "light", label: t("themeLight"), icon: SunIcon },
  { value: "dark", label: t("themeDark"), icon: MoonIcon },
  { value: "system", label: t("themeSystem"), icon: SystemIcon },
];
---

<div class="relative">
  <button
    id="theme-toggle-btn"
    class="relative grid size-9 place-items-center rounded-full text-muted transition hover:bg-ink/5 hover:text-ink"
    aria-label={t("themeToggle")}
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="themes-menu"
  >
    <SunIcon data-theme-icon="light" class="absolute size-[18px] transition-transform duration-300" />
    <MoonIcon data-theme-icon="dark" class="absolute size-[18px] transition-transform duration-300" />
    <SystemIcon data-theme-icon="system" class="absolute size-[18px] transition-transform duration-300" />
  </button>
  <div
    id="themes-menu"
    class="absolute right-0 top-11 hidden min-w-[9rem] rounded-2xl border border-line bg-surface p-1 text-sm shadow-xl shadow-ink/10"
  >
    <ul>
      {
        THEMES.map((theme) => (
          <li>
            <button
              class="flex w-full items-center gap-2 rounded-xl px-3 py-2 text-left text-muted transition hover:bg-ink/5 hover:text-ink focus-visible:bg-ink/5 data-[active=true]:text-ink data-[active=true]:font-medium"
              data-theme-option={theme.value}
            >
              <theme.icon class="size-4" />
              {theme.label}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  #themes-menu.open {
    display: block;
    animation: pop 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    transform-origin: top right;
  }

  @keyframes pop {
    from {
      transform: scale(0.9);
      opacity: 0;
    }
  }
</style>

<script>
  import { setupDropdown } from "../../scripts/dropdown";

  type Theme = "light" | "dark" | "system";

  const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");

  const getThemePreference = (): Theme => {
    try {
      return (localStorage.getItem("theme") as Theme | null) ?? "system";
    } catch {
      return "system";
    }
  };

  const applyTheme = () => {
    const theme = getThemePreference();
    const isDark = theme === "dark" || (theme === "system" && darkQuery.matches);
    document.documentElement.classList.toggle("dark", isDark);

    document.querySelectorAll<SVGElement>("[data-theme-icon]").forEach((icon) => {
      icon.style.scale = icon.dataset.themeIcon === theme ? "1" : "0";
    });
    document.querySelectorAll<HTMLElement>("[data-theme-option]").forEach((option) => {
      option.dataset.active = String(option.dataset.themeOption === theme);
    });
  };

  darkQuery.addEventListener("change", applyTheme);

  document.addEventListener("astro:page-load", () => {
    applyTheme();
    setupDropdown("theme-toggle-btn", "themes-menu");

    document
      .querySelectorAll<HTMLButtonElement>("[data-theme-option]")
      .forEach((option) => {
        option.addEventListener("click", () => {
          try {
            localStorage.setItem("theme", option.dataset.themeOption!);
          } catch {}
          applyTheme();
        });
      });
  });
</script>
