---
import Layout from "../layouts/Layout.astro";

import TitleSection from "../components/TitleSection.astro";
import Hero from "../components/Hero.astro";
import Education from "../components/Education.astro";
import Projects from "../components/Projects.astro";
import AboutMe from "../components/About.astro";

import SectionContainer from "../components/SectionContainer.astro";

import School from "../icons/School.astro";
import CodeIcon from "../icons/Code.astro";
import ProfileCheck from "../icons/ProfileCheck.astro";
---

<Layout
  title="Maria Jose Villarreal - Web developer"
  description="Contrata a María José Villarreal para crear tu aplicación web. Especializada en construir soluciones web responsivas, que combinan un diseño elegante con una navegación intuitiva."
>
  <main class="px-4">
    <SectionContainer id="top" class="py-16 md:py-36">
      <Hero />
    </SectionContainer>
  </main>

  <div class="space-y-24">
    <SectionContainer id="education">
      <TitleSection>
        <School class="size-8" />
        Education
      </TitleSection>
      <Education />
    </SectionContainer>

    <SectionContainer id="projects">
      <TitleSection>
        <CodeIcon class="size-8" />
        Projects
      </TitleSection>
      <Projects />
    </SectionContainer>

    <SectionContainer id="about">
      <TitleSection>
        <ProfileCheck class="size-8" />
        About me
      </TitleSection>
      <AboutMe />
    </SectionContainer>
  </div>
</Layout>
